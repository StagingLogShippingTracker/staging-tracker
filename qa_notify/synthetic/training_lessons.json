    {
      "id": "20260822T181450Z",
      "ts": "2026-08-22T18:14:50Z",
      "title": "Make requires to+cc on every type",
      "lesson": "All seven notification payload shapes must include valid to and cc; Outlook createAndSendAMessage rejects empty CC. Keep Make scenario active.",
      "do_not_regress": "Never ship a notification type without cc; never embed MAKE_EMAIL_WEBHOOK_URL in Flutter.",
      "case_ids": [],
      "tags": [
        "make",
        "cc"
      ]
    },
    {
      "id": "20260822T222029Z",
      "ts": "2026-08-22T22:20:29Z",
      "title": "notify-pm 401 Unauthorized on PO send",
      "lesson": "PO notifications failed with FunctionException 401 Unauthorized when notify-pm used anon createClient().auth.getUser() without explicit JWT. Fix: validate Bearer token via serviceAdmin().auth.getUser(token); client refreshSession + explicit Authorization header; restore app_state _requireAuth(). Deployed notify-pm v90 (platform v94).",
      "do_not_regress": "Never validate notify-pm caller with anon getUser() alone; always pass explicit Bearer access token from client.",
      "case_ids": [
        "payload_keys_po"
      ],
      "tags": [
        "auth",
        "notify-pm"
      ]
    }
  ],
