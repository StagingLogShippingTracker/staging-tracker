# Copy to .env in this folder. Never commit .env.
P21_BASE_URL=https://swiftsupply-api.epicordistribution.com
P21_USERNAME=your.p21.username
P21_PASSWORD=your_p21_password
P21_PROXY_PORT=8787
P21_TLS_REJECT_UNAUTHORIZED=1

# For sync-to-supabase.ps1 (match Supabase Edge Function secret P21_SYNC_KEY)
SUPABASE_URL=https://gdrpdiwykmnybmkadlrv.supabase.co
SUPABASE_ANON_KEY=your_anon_key
P21_SYNC_KEY=generate_a_long_random_secret

# Optional: if this connector runs behind VPN on an internal VM, point Supabase Edge Function secret
# P21_CONNECTOR_URL at http(s)://that-host:8787
