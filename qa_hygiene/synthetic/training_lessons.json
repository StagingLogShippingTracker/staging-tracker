  "lessons": [
    {
      "id": "20260822T184338Z",
      "ts": "2026-08-22T18:43:38Z",
      "title": "Auto-deleted _legacy-downloads-copy (~397MB)",
      "lesson": "Nested full-repo mirrors with .tools/flutter break Windows rmtree (MAX_PATH). Hygiene harness uses robocopy /MIR wipe then rmdir. Safe patterns: _legacy*, .tmp-*, _mcp_deploy, dist-native-log.txt. Protected trees never deleted.",
      "do_not_regress": "Never leave _legacy* mirrors; keep robocopy wipe for Windows; never delete lib/apps/packages/third_party.",
      "case_ids": [
        "auto_delete_safe_dead_paths",
        "no_nested_full_repo_mirror"
      ],
      "tags": [
        "hygiene",
        "storage"
      ]
    },
    {
      "id": "20260909T182901Z",
      "ts": "2026-09-09T18:29:01Z",
      "title": "Packaging scripts must ignore Flutter stderr warnings",
      "lesson": "With ErrorActionPreference=Stop, Flutter KGP/plugin warnings on stderr become terminating NativeCommandError in PowerShell even when exit code is 0, so build-android-apk.ps1 can skip copying the APK to dist. Invoke-RepoFlutter must set ErrorActionPreference=Continue around the flutter call and only fail on non-zero exit.",
      "do_not_regress": "Keep Invoke-RepoFlutter stderr-tolerant; never treat Flutter warnings as build failure.",
      "case_ids": [
        "packaging_stderr_tolerance"
      ],
      "tags": [
        "hygiene",
        "packaging",
        "android"
      ]
    }
  ],
